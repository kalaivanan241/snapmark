{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapmark",
  "version": "0.1.0",
  "identifier": "dev.snapmark.Snapmark",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "12.3"
    }
  }
}
